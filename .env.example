# Copy to .env and fill in your real values. Never commit .env.
# Database connection is required. Others are optional with documented fallbacks.

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ive_app?schema=public"

# --- Auth (Supabase) ---
# Optional. When empty, the app uses a local dev-auth stub (not for production).
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
# Used to sign local dev-auth cookies. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# --- AI (OpenAI-compatible) ---
# Optional. When empty, Edu AI chat reports unavailable without crashing lessons.
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
AI_MAX_CONTEXT_TOKENS="4000"

# --- Storage (S3 / R2 / Supabase) ---
NEXT_PUBLIC_STORAGE_URL=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_BUCKET=""

# --- Redis (optional) ---
REDIS_URL=""
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX="20"