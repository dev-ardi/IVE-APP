// IVE — Visual Education Interactive
// Phase 1 data model (source: IVE_TAD_Phase_1.md §7)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum AIMessageRole {
  USER
  ASSISTANT
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  avatar    String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  progress  UserProgress[]
  attempts  QuizAttempt[]
  favorites Favorite[]
  aiConvos  AIConversation[]
  analytics AnalyticsEvent[]

  @@map("users")
}

model EducationLevel {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subjects Subject[]
  lessons  Lesson[]

  @@map("education_levels")
}

model Subject {
  id               String        @id @default(cuid())
  educationLevelId String
  name             String
  slug             String
  description      String?
  icon             String?
  coverImage       String?
  status           ContentStatus @default(DRAFT)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  educationLevel EducationLevel @relation(fields: [educationLevelId], references: [id], onDelete: Cascade)
  topics         Topic[]
  lessons        Lesson[]

  @@unique([educationLevelId, slug])
  @@index([educationLevelId])
  @@index([slug])
  @@index([status])
  @@map("subjects")
}

model Topic {
  id          String   @id @default(cuid())
  subjectId   String
  name        String
  slug        String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subject Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@unique([subjectId, slug])
  @@index([subjectId])
  @@index([subjectId, order])
  @@map("topics")
}

model Lesson {
  id               String        @id @default(cuid())
  educationLevelId String
  subjectId        String
  topicId          String?
  title            String
  slug             String
  description      String?
  content          Json?
  coverImage       String?
  durationMinutes  Int?          @default(0)
  difficulty       Difficulty    @default(BEGINNER)
  status           ContentStatus @default(DRAFT)
  order            Int           @default(0)
  publishedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  educationLevel EducationLevel @relation(fields: [educationLevelId], references: [id], onDelete: Cascade)
  subject        Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic          Topic?         @relation(fields: [topicId], references: [id], onDelete: SetNull)

  questions Question[]
  progress  UserProgress[]
  attempts  QuizAttempt[]
  favorites Favorite[]
  aiConvos  AIConversation[]
  analytics AnalyticsEvent[]

  @@unique([subjectId, slug])
  @@index([educationLevelId])
  @@index([subjectId])
  @@index([topicId])
  @@index([status])
  @@index([topicId, order])
  @@index([subjectId, status])
  @@map("lessons")
}

model Question {
  id            String     @id @default(cuid())
  lessonId      String
  question      String
  options       Json
  correctAnswer String
  explanation   String?
  difficulty    Difficulty @default(BEGINNER)
  order         Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@map("questions")
}

model UserProgress {
  id           String   @id @default(cuid())
  userId       String
  lessonId     String
  progress     Int      @default(0)
  completed    Boolean  @default(false)
  lastPosition Int?
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@index([userId, updatedAt])
  @@map("user_progress")
}

model QuizAttempt {
  id             String   @id @default(cuid())
  userId         String
  lessonId       String
  score          Int
  totalQuestions Int
  correctAnswers Int
  createdAt      DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lessonId])
  @@index([userId, createdAt])
  @@map("quiz_attempts")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@map("favorites")
}

model AIConversation {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson   Lesson?     @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  messages AIMessage[]

  @@index([userId, lessonId])
  @@map("ai_conversations")
}

model AIMessage {
  id             String        @id @default(cuid())
  conversationId String
  role           AIMessageRole
  content        String
  createdAt      DateTime      @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ai_messages")
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?
  eventName String
  lessonId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([lessonId])
  @@index([eventName, createdAt])
  @@map("analytics_events")
}
